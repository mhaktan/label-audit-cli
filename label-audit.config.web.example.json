{
  "sourceName": "etechlog-web",
  "platform": "web",
  "rootDir": "..",
  "sourceGlobs": ["src/**/*.{js,jsx,ts,tsx}"],
  "translationFnNames": ["t"],
  "parserPlugins": [],
  "dbSource": {
    "url": "https://<backend-host>/api/language/en/true",
    "headers": {
      "Authorization": "Bearer ${LABEL_API_TOKEN}"
    },
    "arrayPath": "data",
    "keyField": "key",
    "platformFlagFields": {
      "web": "isWebLabel",
      "mobile": "isMobileLabel"
    }
  }
}
