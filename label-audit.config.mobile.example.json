{
  "sourceName": "etechlog-mobile",
  "platform": "mobile",
  "rootDir": "../../etechlog-mobile",
  "sourceGlobs": ["src/**/*.{js,jsx,ts,tsx}"],
  "translationFnNames": ["t"],
  "parserPlugins": [],
  "dbSource": {
    "url": "https://<backend-host>/api/language",
    "headers": {
      "Authorization": "Bearer ${LABEL_API_TOKEN}"
    },
    "arrayPath": "data",
    "keyField": "key",
    "platformFlagFields": {
      "web": "forUI",
      "mobile": "forMobile"
    },
    "pagination": {
      "pageParam": "Page",
      "pageSizeParam": "PageSize",
      "pageSize": 500,
      "totalCountPath": "totalCount"
    }
  }
}
